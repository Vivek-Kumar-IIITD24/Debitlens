# -----------------------------
# APPLICATION
# -----------------------------

NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# -----------------------------
# NEO4J AURADB
# -----------------------------

NEO4J_ENABLED=true
NEO4J_URI=<PASTE_YOUR_AURA_URI_HERE>
NEO4J_USERNAME=<PASTE_YOUR_AURA_USERNAME_HERE>
NEO4J_PASSWORD=<PASTE_YOUR_AURA_PASSWORD_HERE>
NEO4J_DATABASE=neo4j

# -----------------------------
# SARVAM AI
# -----------------------------

SARVAM_ENABLED=true
SARVAM_API_KEY=<PASTE_YOUR_SARVAM_API_KEY_HERE>
SARVAM_BASE_URL=https://api.sarvam.ai

SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_TRANSLATION_MODEL=sarvam-translate:v1

SARVAM_DEFAULT_LANGUAGE=en-IN

# -----------------------------
# DEMO MODE
# -----------------------------

DEMO_MODE=true
ALLOW_LOCAL_PREVIEW=true
